# F.E.D.O. HUB (Personal Edition) — шаблон systemd.
# Плейсхолдеры @APP_DIR@ / @DATA_DIR@ / @ENV_FILE@ / @PORT@ подставляет
# scripts/ubuntu/install.sh. Юнит изолирован: свои имя, каталоги, лимиты.
# Чужие сервисы (например GGSELL) не затрагиваются.
[Unit]
Description=F.E.D.O. HUB (Personal Edition)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fedo
Group=fedo
WorkingDirectory=@APP_DIR@/current
EnvironmentFile=@ENV_FILE@
Environment=FEDO_ROLE=hub
Environment=FEDO_DATA_DIR=@DATA_DIR@
Environment=FEDO_HOST=127.0.0.1
Environment=FEDO_PORT=@PORT@
ExecStart=@APP_DIR@/current/.venv/bin/python -m ecosystem.backend --role hub --host 127.0.0.1 --port @PORT@
Restart=on-failure
RestartSec=5
# Минимальные привилегии: запись только в каталог данных
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@DATA_DIR@
MemoryMax=512M
CPUQuota=100%

[Install]
WantedBy=multi-user.target

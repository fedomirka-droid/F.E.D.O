# ============================================================
# F.E.D.O. Ecosystem — пример окружения (без реальных секретов)
# Скопируй в .env и заполни. .env НЕ коммитится в Git.
# ============================================================

# --- Роль процесса -------------------------------------------------
# hub      — центральный сервер синхронизации (VPS)
# desktop  — локальный backend настольного приложения
FEDO_ROLE=hub

# Каталог данных (SQLite, бэкапы, логи, секрет приложения)
FEDO_DATA_DIR=/var/lib/fedo

# --- Сеть -----------------------------------------------------------
FEDO_HOST=127.0.0.1
FEDO_PORT=8765
# Через nginx: https://fedo.example.com
FEDO_CORS_ORIGINS=https://fedo.example.com,tauri://localhost,http://tauri.localhost

# --- Секреты (сгенерируй сам, НЕ коммить) ---------------------------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
FEDO_SECRET_KEY=
# Токен первичной настройки владельца (нужен только на HUB в интернете)
FEDO_SETUP_TOKEN=
# Сервисный токен Telegram-бота (бот не имеет прав владельца)
FEDO_BOT_SERVICE_TOKEN=

# Публичная регистрация всегда выключена в Personal Edition
FEDO_ALLOW_PUBLIC_REGISTRATION=false
FEDO_SESSION_TTL_HOURS=720

# --- Telegram -------------------------------------------------------
FEDO_TELEGRAM_BOT_TOKEN=
FEDO_TELEGRAM_LINK_TTL_MINUTES=10
FEDO_TELEGRAM_LINK_MAX_ATTEMPTS=5
# Для процесса бота (Mini)
FEDO_HUB_URL=https://fedo.example.com

# --- AI Router ------------------------------------------------------
# Локальная LM Studio на этом устройстве
FEDO_LOCAL_AI_URL=http://127.0.0.1:1234/v1
FEDO_AI_REQUEST_TIMEOUT=120

# --- Синхронизация (Desktop) ---------------------------------------
# Адрес HUB и токен устройства, выданный в Desktop → Устройства
FEDO_HUB_URL=
FEDO_SYNC_DEVICE_TOKEN=
FEDO_SYNC_ENABLED=true
FEDO_SYNC_INTERVAL_SECONDS=15

# --- Лимиты ---------------------------------------------------------
FEDO_API_RATE_LIMIT=240
FEDO_API_RATE_WINDOW=60

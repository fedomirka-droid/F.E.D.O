# F.E.D.O — пример переменных окружения (v1.5.11)
# Скопируй в .env и впиши свои значения. .env в git НЕ едет (см. .gitignore).

# API-ключ Gemini для гибридного режима (v1.6.0). Имеет приоритет над
# ключом из data/settings.json (GUI). Пока гибрида нет — можно оставить пустым.
FEDO_GEMINI_API_KEY=

# Владельцы Telegram-бота (v1.7) — id через запятую. Удобнее задавать
# в настройках (telegram_owner_ids), env — запасной путь.
# FEDO_TELEGRAM_OWNER_IDS=123456789

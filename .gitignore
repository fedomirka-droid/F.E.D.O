# ============================================================
# F.E.D.O — Git Ignore
# ============================================================

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# Logs and runtime data
# v1.5.11: ВЕСЬ data/ — личный (чаты, истории, профиль, настройки с ключами),
# в git не едет — иначе переписка и ключи утекут на GitHub
logs/
*.log
data/
settings.json
memory.json

# Environment files
.env
.env.local

# IDE
.idea/
.vscode/

# Build
dist/
build/
*.spec

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.bak